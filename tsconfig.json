{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "npm:@supabase/supabase-js@2.116.0": [
        "./node_modules/@supabase/supabase-js/dist/index.d.mts"
      ],
      "npm:livekit-server-sdk@2.19.0": [
        "./node_modules/livekit-server-sdk/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "electron",
    "vite.config.ts",
    "tests",
    "supabase/deno.d.ts"
  ]
}
